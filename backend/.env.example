NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://sparkle:sparkle@localhost:5432/sparkle
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYPAL_WEBHOOK_ID=...
PAYPAL_ENV=sandbox
CHECKR_API_KEY=...
CHECKR_WEBHOOK_SECRET=...
GOOGLE_MAPS_KEY=...
TWILIO_ACCOUNT_SID=...
TWILIO_AUTH_TOKEN=...
TWILIO_PROXY_SERVICE_SID=...
# SMS OTP sender — a Messaging Service SID is preferred over a bare number.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=+19785551234
# Transactional email. Leave POSTMARK_TOKEN unset in local dev to log instead of send.
POSTMARK_TOKEN=
MAIL_FROM=Sparkle <no-reply@sparkle.app>
APP_URL=https://app.sparkle.app
# Both required together -- without FIREBASE_DATABASE_URL, initializeApp()
# can't infer it from the cert() credential and RealtimeService throws
# "Can't determine Firebase Database URL" on the first en_route/arrived
# status update (that call is inside BookingService.updateStatus's
# transaction, so it fails the whole transition, not just tracking/chat).
FIREBASE_SERVICE_ACCOUNT_JSON=./secrets/firebase.json
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
S3_BUCKET=sparkle-documents
AWS_REGION=us-east-1
# Observability. Leave METRICS_TOKEN unset to serve /metrics unauthenticated
# (fine on a trusted network); the worker exposes its own /metrics on this port.
METRICS_TOKEN=
WORKER_METRICS_PORT=9101
